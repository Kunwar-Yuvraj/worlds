FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
LLM_PROVIDER=gemini
GEMINI_API_KEY=key1,key2
GEMINI_MODEL=gemini-3.5-flash
# Note: GEMINI_API_KEY or GEMINI_API_KEYS accepts comma-separated keys for round-robin rotation & rate-limit fallback
# OpenAI TTS is independent of the story LLM provider.
OPENAI_API_KEY=
TTS_MODEL=gpt-4o-mini-tts
# Or: LLM_PROVIDER=openai, OPENAI_MODEL=gpt-4o-mini
